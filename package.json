{
  "name": "tastyspore",
  "version": "1.0.0",
  "private": true,
  "description": "tastyspore",
  "author": "Trevor Smith",
  "keywords": [
    "gatsby"
  ],
  "scripts": {
    "develop": "BUILD_ENV=development gatsby develop -H 0.0.0.0",
    "start": "BUILD_ENV=development gatsby develop -H 0.0.0.0",
    "cname:add": "echo tastyspore.com > public/CNAME",
    "build": "BUILD_ENV=production yarn clean && gatsby build && yarn cname:add",
    "serve": "gatsby serve -H 0.0.0.0",
    "clean": "gatsby clean",
    "deploy": "npx gh-pages -d public",
    "cap:update": "npx cap update android",
    "cap:open": "npx cap open android",
    "android": "yarn cap:update && yarn cap:open"
  },
  "dependencies": {
    "@formspree/react": "^3.0.0",
    "@mdx-js/react": "^3.1.1",
    "babel-plugin-styled-components": "^2.1.4",
    "gatsby": "^5.15.0",
    "gatsby-env-variables": "^2.0.0",
    "gatsby-plugin-breakpoints": "^1.3.11",
    "gatsby-plugin-graphql-codegen": "^3.1.1",
    "gatsby-plugin-htaccess": "^1.4.0",
    "gatsby-plugin-image": "^3.15.0",
    "gatsby-plugin-manifest": "^5.15.0",
    "gatsby-plugin-mdx": "^5.15.0",
    "gatsby-plugin-react-helmet": "^6.15.0",
    "gatsby-plugin-robots-txt": "^1.8.0",
    "gatsby-plugin-root-import": "^2.0.9",
    "gatsby-plugin-sass": "^6.15.0",
    "gatsby-plugin-sharp": "^5.15.0",
    "gatsby-plugin-sitemap": "^6.15.0",
    "gatsby-plugin-styled-components": "^6.15.0",
    "gatsby-plugin-transition-link": "^1.20.5",
    "gatsby-source-filesystem": "^5.15.0",
    "gatsby-transformer-sharp": "^5.15.0",
    "gsap": "^3.13.0",
    "intersection-observer": "^0.12.2",
    "minireset.css": "^0.0.7",
    "prop-types": "^15.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet": "^6.1.0",
    "react-spring": "^10.0.3",
    "sass": "^1.94.2",
    "styled-components": "^6.1.19",
    "usehooks-ts": "^3.1.1"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^8.47.0",
    "@typescript-eslint/parser": "^8.47.0",
    "eslint": "^9.39.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3"
  }
}
